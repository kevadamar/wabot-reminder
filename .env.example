# Database Connection (Configurable for local docker, remote VPS, Supabase, Neon, etc.)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/todo_bot

# Google Gemini API Key (For Indonesian NLP task parsing & affirmations)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_THINKING_LEVEL=MEDIUM
GEMINI_TIMEOUT_MS=3000

# Provider order, left to right. `local` is always last and is appended if omitted.
# Leave these empty to keep today's behavior:
#   nlp / affirmation / reminder = gemini, antigravity, local
#   morning / vision = gemini, local
#   link = gemini, antigravity, local
# Valid ids: gemini, openai, anthropic, antigravity, local
# Vision and link accept gemini, anthropic, antigravity, openai (with OPENAI_VISION=true) and local.
LLM_CHAIN_DEFAULT=
LLM_CHAIN_NLP=
LLM_CHAIN_AFFIRMATION=
LLM_CHAIN_REMINDER=
LLM_CHAIN_MORNING=
LLM_CHAIN_VISION=
LLM_CHAIN_LINK=
LLM_TOTAL_BUDGET_MS=28000
# Vision time budget. Defaults to 8000, or LLM_TOTAL_BUDGET_MS when antigravity is in the vision
# chain (the CLI needs ~13-30s per image). Keep it above ANTIGRAVITY_TIMEOUT_MS so later providers still get a turn.
LLM_VISION_BUDGET_MS=
# Link review runs after the reply is sent, so it gets its own budget (page text + screenshot).
LLM_LINK_BUDGET_MS=60000
LLM_MAX_RETRIES=0
LLM_MAX_INPUT_CHARS=2000
LLM_BREAKER_FAILURE_THRESHOLD=5
LLM_BREAKER_WINDOW_MS=60000
LLM_BREAKER_COOLDOWN_MS=30000

# LLM call visibility. One console line per provider attempt ([LLM] <id> ...), also shown on the
# dashboard "LLM Calls" page. The <id> is sent to the bridge as X-Request-Id, so bridge logs match.
LLM_LOG_CALLS=true
# Also capture prompt/response text (personal data & secrets redacted, truncated). Debugging only.
LLM_LOG_PAYLOADS=false
LLM_LOG_PAYLOAD_MAX_CHARS=2000

# OpenAI or any Chat Completions-compatible endpoint (OpenRouter, Groq, Ollama, ...)
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_MS=5000
OPENAI_STRUCTURED_OUTPUT=true
OPENAI_VISION=false

# Anthropic Messages API (optional)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ANTHROPIC_TIMEOUT_MS=5000

# Owner / Whitelisted WhatsApp Phone Number (e.g. 628123456789 - without '+' or spaces)
OWNER_NUMBER=

# Default Bot Timezone (e.g. Asia/Jakarta for WIB, Asia/Makassar for WITA, Asia/Jayapura for WIT)
TIMEZONE=Asia/Jakarta

# Default Advance Reminder Notice in Minutes (Fallback if not configured in user_settings)
DEFAULT_REMINDER_LEAD_MINUTES=10

# Anti-spam pacing: jittered gap between automated messages (reminders / morning digest)
# sent to the SAME chat. Min must be >= 6000 (WhatsApp pair rate limit). Other chats are not delayed.
REMINDER_PACING_MIN_MS=20000
REMINDER_PACING_MAX_MS=30000

# Baileys Multi-File Auth Directory
AUTH_DIR=./auth_info

# Antigravity CLI Host Bridge (Optional LLM fallback if running `bun run scripts/antigravity-bridge.ts` on host)
# When running inside Docker on Dokploy/VPS: http://host.docker.internal:7860
# Generate a token with: openssl rand -hex 32
# The same value must be set on the host process that runs the bridge.
ANTIGRAVITY_BRIDGE_URL=
ANTIGRAVITY_BRIDGE_TOKEN=
ANTIGRAVITY_TIMEOUT_MS=25000
# http:// is always allowed for in-server / private hosts (localhost, 127.x, 10.x, 172.16-31.x,
# 192.168.x, 100.64-127.x, Docker service names, *.internal, *.local). Public hosts need https,
# or must be listed here (entries may be bare hosts, host:port, or full URLs).
LLM_INSECURE_HOST_ALLOWLIST=localhost,127.0.0.1,host.docker.internal
# Set on the host process that runs the bridge (not the bot): log prompt/output text per request
# (redacted, truncated). Metadata lines ([Bridge] <id> POST /generate → 200 ...) are always logged.
# BRIDGE_LOG_PAYLOADS=false
# BRIDGE_LOG_PAYLOAD_MAX_CHARS=2000

# Link check: links in messages are opened by the isolated link-inspector service (headless Chromium),
# checked against Google Safe Browsing, and judged by the LLM. The result arrives as a follow-up message;
# a dangerous link puts the task on hold until the user replies "lanjut" or "batal".
LINK_CHECK_ENABLED=false
# Docker compose service name; on Dokploy use the inspector app's internal host.
LINK_INSPECTOR_URL=http://link-inspector:7870
# Same value on the bot and the inspector. Generate with: openssl rand -hex 32
LINK_INSPECTOR_TOKEN=
LINK_CHECK_TIMEOUT_MS=30000
LINK_CHECK_MAX_LINKS=2
# Extra domains to skip (subdomains included), e.g. your own sites. Popular domains are built in.
LINK_CHECK_ALLOWLIST=
# Optional. Google Safe Browsing v4 Lookup API key (free, non-commercial use only).
GOOGLE_SAFE_BROWSING_API_KEY=
# Set on the inspector only: optional upstream HTTP proxy (e.g. residential) so pages see a home IP
# instead of the server's datacenter IP. Format: http://user:pass@host:port
# LINK_CHECK_PROXY_URL=

# Log Level (silent, trace, debug, info, warn, error, fatal)
LOG_LEVEL=info

# Lightweight read-only monitoring dashboard (disabled by default)
# Keep DASHBOARD_HOST on 127.0.0.1 unless it is protected by a private proxy/tunnel.
DASHBOARD_ENABLED=false
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=3080
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=
TELEMETRY_FLUSH_INTERVAL_MS=60000

# Attachment Storage Provider ('local' stores files under ./storage; 's3' uses the S3_* settings below)
STORAGE_DRIVER=local
S3_ENDPOINT=http://rust-s3:9000
S3_BUCKET=todo-attachments
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
