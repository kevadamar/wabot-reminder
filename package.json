{
  "name": "todo-reminder-bot",
  "version": "1.0.0",
  "description": "WhatsApp to-do & reminder bot in Bahasa Indonesia: natural-language tasks, adaptive reminders, scam/judol alerts, and a configurable LLM provider chain.",
  "license": "MIT",
  "author": "kevadamar",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kevadamar/wabot-reminder.git"
  },
  "homepage": "https://github.com/kevadamar/wabot-reminder#readme",
  "bugs": {
    "url": "https://github.com/kevadamar/wabot-reminder/issues"
  },
  "keywords": [
    "whatsapp",
    "bot",
    "reminder",
    "todo",
    "baileys",
    "bun",
    "gemini",
    "indonesia"
  ],
  "engines": {
    "bun": ">=1.2"
  },
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "bun run db:push && bun run src/index.ts",
    "dev": "bun --watch run src/index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/qrcode-terminal": "^0.12.2",
    "drizzle-kit": "^0.31.11",
    "typescript": "^5.8.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@google/genai": "^2.27.0",
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "chrono-node": "^2.10.2",
    "drizzle-orm": "^0.45.3",
    "file-type": "^22.1.1",
    "pino": "^10.4.0",
    "postgres": "^3.4.9",
    "qrcode-terminal": "^0.12.0",
    "sharp": "^0.35.5"
  }
}
