{
  "name": "todo-reminder-bot",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "bun run db:push && bun run src/index.ts",
    "dev": "bun --watch run src/index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/qrcode-terminal": "^0.12.2",
    "drizzle-kit": "^0.31.11",
    "typescript": "^5.8.0"
  },
  "dependencies": {
    "@google/genai": "^2.24.0",
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "chrono-node": "^2.10.1",
    "drizzle-orm": "^0.45.3",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "qrcode-terminal": "^0.12.0"
  }
}
